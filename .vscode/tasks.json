{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "LaTeX: Vorschau und Gesamt-PDFs aktualisieren",
      "type": "shell",
      "command": "powershell",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\tools\\build-update.ps1"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
