{
  "latex-workshop.latex.autoBuild.run": "never",
  "latex-workshop.latex.recipes": [
    {
      "name": "Geänderte Übungsblätter (beide Varianten)",
      "tools": [
        "exercise_sheets"
      ]
    }
  ],
  "latex-workshop.latex.tools": [
    {
      "name": "exercise_sheets",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "%DIR%/tools/build-all.ps1",
        "-Language",
        "de",
        "-Solutions",
        "both",
        "-Incremental"
      ]
    }
  ],
  "latex-workshop.latex.recipe.default": "first"
}
